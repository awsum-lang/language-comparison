{- This program builds an immutable tree of depth `treeDepth`, mirrors it
   `mirrorCount` times, and prints the deepest value on the left path. Both are
   read from argv (IO.Args.getArgs); the recorded run (assert-behavior.sh)
   passes a per-target depth (LLVM/JVM/CLR `50000000`; WASM `19000000`, capped
   by its ~4 GB linear memory; JS `11000000`, capped by the V8 heap) — each
   bounded by memory, never the stack.

   Every recursion shape is stack-safe on every target, including JVM and JS
   where native cross-method TCO doesn't exist.

   JVM, CLR, and JS targets use their GCs.
   LLVM and WASM targets use static lifetimes — no GC, no explicit lifetime annotations. -}

import IO.Stdout
import IO.Args

type Tree a = Leaf | Node (Tree a) a (Tree a)

type NoArg = NoArg

main : IO Never Unit
main = IO.Args.getArgs
  |> andThenIO runWithArgs
  |> handleErrorIO handleArgsError

handleArgsError : (StringTooLong | UnpairedUtf16Surrogate) -> IO Never Unit
handleArgsError e = case e of
  (_l : StringTooLong) -> IO.Stdout.print "STRING_TOO_LONG"
  (_u : UnpairedUtf16Surrogate) -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"

runWithArgs : List String -> IO Never Unit
runWithArgs args = case runDemo args of
  Left e -> showRunError e |> IO.Stdout.print
  Right n -> showInt32 n |> IO.Stdout.print

showRunError : (NoArg | ParseError | UnderflowError) -> String
showRunError e = case e of
  (_n : NoArg) -> "MISSING_ARG"
  (p : ParseError) -> showParseError p
  (u : UnderflowError) -> showUnderflowError u

runDemo : List String -> Either (NoArg | ParseError | UnderflowError) Int32
runDemo args = do
  depthStr <- nothingAsLeft NoArg (headList args)
  rest <- nothingAsLeft NoArg (tailList args)
  mirrorStr <- nothingAsLeft NoArg (headList rest)
  treeDepth <- parseInt32 depthStr
  mirrorCount <- parseInt32 mirrorStr
  tree <- buildTree treeDepth
  mirrored <- mirrorN mirrorCount tree
  Right (deepestLeftA 0 mirrored)

buildTree : Int32 -> Either UnderflowError (Tree Int32)
buildTree depth = do
  l <- buildLeft depth Leaf
  r <- buildRight depth Leaf
  Right (Node l 0 r)

buildLeft : Int32 -> Tree Int32 -> Either UnderflowError (Tree Int32)
buildLeft depth acc = case eqInt32 depth 0 of
  True -> Right acc
  False -> do
    d <- predInt32 depth
    buildLeft d (Node acc depth Leaf) -- tail recursion

buildRight : Int32 -> Tree Int32 -> Either UnderflowError (Tree Int32)
buildRight depth acc = case eqInt32 depth 0 of
  True -> Right acc
  False -> do
    d <- predInt32 depth
    buildRight d (Node Leaf depth acc) -- tail recursion

mirror : Tree a -> Tree a
mirror t = case t of
  Leaf -> Leaf
  Node l v r -> Node (mirror r) v (mirror l) -- multi-child non-tail recursion

mirrorN : Int32 -> Tree a -> Either UnderflowError (Tree a)
mirrorN times t = case eqInt32 times 0 of
  True -> Right t
  False -> do
    m <- predInt32 times
    mirrorN m (mirror t) -- tail recursion

deepestLeftA : a -> Tree a -> a
deepestLeftA lastV t = case t of
  Leaf -> lastV
  Node l v _r -> deepestLeftB v l -- 3-node mutual tail recursion

deepestLeftB : a -> Tree a -> a
deepestLeftB lastV t = case t of
  Leaf -> lastV
  Node l v _r -> deepestLeftC v l -- 3-node mutual tail recursion

deepestLeftC : a -> Tree a -> a
deepestLeftC lastV t = case t of
  Leaf -> lastV
  Node l v _r -> deepestLeftA v l -- 3-node mutual tail recursion
