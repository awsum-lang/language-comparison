<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Force F# to emit CIL `tail.` prefix on tail calls even in Debug
         builds (Release has it on by default). Without this, Debug runs
         use plain `call` and lose mutual-tail-call optimisation. -->
    <Tailcalls>true</Tailcalls>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

</Project>
